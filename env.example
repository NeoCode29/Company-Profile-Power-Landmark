# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/power_landmark_db"
DATABASE_SCHEMA_URL="postgresql://username:password@localhost:5432/power_landmark_db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# iPay88 Payment Gateway Configuration (Sandbox credentials)
# Use default values for testing, or get real credentials from iPay88
IPAY88_MERCHANT_CODE="ID00001"
IPAY88_MERCHANT_KEY="your-merchant-key"

# Google Drive API Configuration (for image upload)
GOOGLE_CLIENT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-google-private-key-here\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Application Configuration
NODE_ENV="development" 