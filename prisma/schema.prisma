generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product{
  id    String @id @default(uuid())
  name  String
  price Int
  stock Int
  description String
  image ImageProduct[]
}

model ImageProduct{
  id    String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  url String
}

model User{
  id    String @id @default(uuid())
  name  String
  email String
  password String 
}

